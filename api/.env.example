# Neon pooled connection string (Neon dashboard > Connect > "Pooled connection")
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# 32+ random chars: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public site URL, no trailing slash. Ignored on Vercel previews, which use their branch URL.
BETTER_AUTH_URL=https://crown-survivors.vercel.app
# X developer app > Keys and tokens > OAuth 2.0 Client ID and Client Secret
X_CLIENT_ID=
X_CLIENT_SECRET=
# Optional: comma-separated extra allowed origins (defaults below are always allowed)
# EXTRA_ORIGINS=
# Emails (comma-separated) that can sign in to the /admin stats dashboard by magic link. Empty = nobody.
ADMIN_EMAILS=
# Resend (resend.com) API key for the magic link email
RESEND_API_KEY=
# Optional; defaults to Crown Survivors <onboarding@resend.dev>
# EMAIL_FROM=Crown Survivors <onboarding@resend.dev>
# Sentry (production API). Browser uses the same DSN baked into public/sentry-init.js; override here for the API.
# SENTRY_DSN=https://70b3e66d43142d4f14da7a5027f74434@o4510091891769344.ingest.de.sentry.io/4512351983370320
